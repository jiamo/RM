    _ ≤ (27*(sourceCuspScale s.index)^2*(Ideal.absNorm (Ideal.span {c}):ℝ)^2)^2*
        ((Z^Lcap)^5*(Z^Lcap)^5*(Z^Lcap)^5*(Z^Lcap)^2) := by gcongr
